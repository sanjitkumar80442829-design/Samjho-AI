rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: users can only read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Student Profiles collection: users can only read and write their own private learning profile
    match /studentProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Educational Knowledge Structure (Phase 3)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /concepts/{conceptId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /conceptPrerequisites/{prereqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // By default, deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
